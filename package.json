{
  "name": "outform",
  "version": "0.1.0",
  "description": "Turn any URL or local file into AI-ready Markdown, text, or JSON",
  "keywords": [
    "ai",
    "cli",
    "content-extraction",
    "markdown",
    "pdf",
    "youtube"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "outform": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zvadaadam/extractor.git"
  },
  "homepage": "https://github.com/zvadaadam/extractor#readme",
  "bugs": {
    "url": "https://github.com/zvadaadam/extractor/issues"
  },
  "scripts": {
    "build": "tsup",
    "build:binary": "bun scripts/build-binary.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test"
  },
  "prettier": {
    "printWidth": 120
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/turndown": "^5.0.6",
    "prettier": "3.6.2",
    "tsup": "^8",
    "typescript": "^5"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "pdf-parse": "^2.4.5",
    "turndown": "^7.2.4"
  }
}
